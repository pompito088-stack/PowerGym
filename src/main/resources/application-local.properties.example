# Plantilla OPCIONAL de configuracion local. application-local.properties NO se sube a git.
#
# Con XAMPP no hace falta: application.properties ya usa root sin contrasena (lo normal en XAMPP),
# y la base de datos powergym_db y las tablas se crean solas al arrancar.
#
# Solo si tu MySQL tiene otro usuario o contrasena:
#   1. Copia este archivo como "application-local.properties" (sin ".example") en esta carpeta.
#   2. Cambia los valores de abajo por los tuyos.
#   3. Integracion a commit Johan

spring.datasource.username=root
spring.datasource.password=
